# Europe InfraAtlas environment variables (data scripts only). Copy to .env and fill in.
# NEVER commit .env. The frontend needs no keys.

# --- ENTSO-E Transparency (hydro reservoirs in scripts/fetch_eu_reference.py) -----
# Free: register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# with subject "Restful API access" to have the API token enabled on your account.
# For the cloud refresh, add the same value as a GitHub repo secret ENTSOE_API_KEY.
ENTSOE_API_KEY=

# --- GIE AGSI+ (gas storage fill per country, scripts/fetch_eu_dossier.py) ----
# Free: register at https://agsi.gie.eu/account, set access to "Both ALSI and AGSI+".
AGSI_API_KEY=

# --- Ember (yearly generation and carbon intensity, scripts/fetch_eu_dossier.py) -
# Free: https://ember-energy.org/data/api (key arrives by email).
EMBER_API_KEY=

# --- EIA (US grid, hourly EIA-930 data, scripts/fetch_us.py) --------------------
# Free: https://www.eia.gov/opendata/register.php (key arrives by email).
EIA_API_KEY=

# For the cloud refresh add ENTSOE_API_KEY, AGSI_API_KEY, EMBER_API_KEY and EIA_API_KEY as GitHub
# repository secrets (Settings > Secrets and variables > Actions).

# Energy-Charts needs no key.
