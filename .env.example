# Europe InfraAtlas environment variables (data scripts only). Copy to .env and fill in.
# NEVER commit .env. The frontend needs no keys.

# --- ENTSO-E Transparency (hydro reservoirs in scripts/fetch_eu_reference.py) -----
# Free: register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# with subject "Restful API access" to have the API token enabled on your account.
# For the cloud refresh, add the same value as a GitHub repo secret ENTSOE_API_KEY.
ENTSOE_API_KEY=

# --- GIE AGSI+ (gas storage fill per country, scripts/fetch_eu_dossier.py) ----
# Free: register at https://agsi.gie.eu/account, set access to "Both ALSI and AGSI+".
AGSI_API_KEY=

# --- Ember (yearly generation and carbon intensity, scripts/fetch_eu_dossier.py) -
# Free: https://ember-energy.org/data/api (key arrives by email).
EMBER_API_KEY=

# --- EIA (US grid, hourly EIA-930 data, scripts/fetch_us.py) --------------------
# Free: https://www.eia.gov/opendata/register.php (key arrives by email).
EIA_API_KEY=

# --- PJM Data Miner 2 (US day-ahead price at Western Hub, scripts/fetch_us_prices.py) -
# Free: register at https://apiportal.pjm.com and subscribe to the Data Miner 2 product;
# the primary key goes here. Without it PJM is skipped (the API answers 401). In the
# cloud environment it is a network secret adding Ocp-Apim-Subscription-Key to api.pjm.com.
PJM_API_KEY=

# --- EPA Clean Air Markets (US fossil units hour by hour, scripts/build_us_units.py) -
# Free: https://api.data.gov/signup/ (key arrives by email). Sent as the X-Api-Key header
# only. On the cloud environment it is a network secret: the proxy adds the header.
EPA_API_KEY=

# --- NREL Alternative Fuels Data Center (US EV fast chargers, scripts/fetch_ev_chargers.py) -
# An api.data.gov key (https://developer.nrel.gov/signup/; any api.data.gov key works, the EPA
# one included). Sent as the api_key parameter. GitHub repo secret NREL_API_KEY (the workflow
# falls back to EPA_API_KEY).
NREL_API_KEY=

# --- ERCOT public API (Texas prices at every node, docs/tasks/10) ----------------
# Free: sign up at https://apiexplorer.ercot.com, subscribe to the "Public API" product and
# copy the primary key from your profile. The scripts log in with the same username and
# password for a token (names as the gridstatus library reads them). GitHub repo secrets.
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=

# --- ISO New England web services (prices at every node, live queue, docs/tasks/10) -
# Free: an ISO Express account with web services access
# (https://www.iso-ne.com/participate/applications-status-changes/access-software-systems#ws-api).
# HTTP basic auth with the same username and password. GitHub repo secrets.
ISONE_API_USERNAME=
ISONE_API_PASSWORD=

# --- AESO (Alberta live grid, PLAN.md global 3) ---------------------------------
# Free: sign up at https://developer-apim.aeso.ca, confirm the email, subscribe to the
# public API product, copy the primary subscription key.
AESO_API_KEY=

# --- data.go.kr (South Korea: KPX demand and regional solar/wind, PLAN.md global 4) -
# Free: create an account at https://www.data.go.kr, open the Korea Power Exchange
# datasets ("한국전력거래소"), press "활용신청" (apply for use); the decoded service key
# appears under My page > API keys.
DATA_GO_KR_KEY=

# --- EPİAŞ (Turkey transparency platform, PLAN.md global 5) -----------------------
# Free: register at https://kayit.epias.com.tr (transparency platform user); the
# scripts log in with the same email and password to get a ticket.
EPIAS_USERNAME=
EPIAS_PASSWORD=

# --- Global Energy Monitor download form (scripts/fetch_gem.py) ------------------
# Your own details, as you would type them into GEM's form at
# https://globalenergymonitor.org/download-data . The script submits the form only when a
# tracker has a new release. GEM_SECTOR is one of: Academic / Research, Civil Society / NGO,
# Financial / Investor, Government, Industry, Journalism / Media, Other.
GEM_NAME=
GEM_EMAIL=
GEM_ORGANIZATION=
GEM_SECTOR=
GEM_COUNTRY=

# For the cloud refresh add every key above as a GitHub repository secret of the same
# name (Settings > Secrets and variables > Actions).

# Energy-Charts, Taipower, IESO, ECMWF open data, IRENA and the US markets' day-ahead
# prices (CAISO, ERCOT, MISO, SPP, NYISO, ISO-NE) need no key.
