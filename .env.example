# Germany InfraAtlas environment variables. Copy to .env and fill in. NEVER commit .env.
# Setup walkthrough: docs/SETUP.md

# --- Supabase (required) ----------------------------------------------------
# Project dashboard -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Settings -> API -> service_role secret key. Server-side only (backend + ingestion).
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API -> anon public key. Safe for the browser; used by the frontend only.
SUPABASE_ANON_KEY=

# --- Google Earth Engine (optional asset lifecycle signals) ----------------
# Service account email, e.g. infra-atlas@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=
# Absolute path to the downloaded service-account JSON key file (keep outside the repo
# or in ./secrets/ which is gitignored)
GEE_SERVICE_ACCOUNT_KEY_FILE=

# --- ENTSO-E Transparency (planned power-system adapter) --------------------
# Free: register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# with subject "Restful API access" to have the API token enabled on your account.
ENTSOE_API_KEY=

# --- Deutsche Bahn API Marketplace ------------------------------------------
# Create an application in the DB API Marketplace and subscribe it to Timetables.
# Keep these server-side only. Do not expose them as VITE_* variables.
DB_CLIENT_ID=
DB_API_KEY=

# --- Strategic analyst LLM --------------------------------------------------
# OpenAI-compatible providers — pick one with LLM_PROVIDER (deepseek | groq | gemini).
LLM_PROVIDER=deepseek
# DeepSeek (paid, cheap, reliable tool use) — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Groq (free, fast) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend (frontend/.env.local, Vite requires the VITE_ prefix) ----------
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=

# --- Electricity Maps (optional evaluation source) --------------------------
# https://www.electricitymaps.com/free-tier-api — carbon intensity, power
# breakdown, cross-border flows, forecasts. Var name matches what's in .env.
Electricty_Maps=

# Bright Sky (DWD weather) and SMARD need no keys.
