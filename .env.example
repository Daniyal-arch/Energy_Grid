# gridwatch environment variables. Copy to .env and fill in. NEVER commit .env.
# Setup walkthrough: docs/SETUP.md

# --- Supabase (required, Phase 1) -------------------------------------------
# Project dashboard -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Settings -> API -> service_role secret key. Server-side only (backend + ingestion).
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API -> anon public key. Safe for the browser; used by the frontend only.
SUPABASE_ANON_KEY=

# --- Google Earth Engine (required, Phase 1) --------------------------------
# Service account email, e.g. gridwatch@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=
# Absolute path to the downloaded service-account JSON key file (keep outside the repo
# or in ./secrets/ which is gitignored)
GEE_SERVICE_ACCOUNT_KEY_FILE=

# --- ENTSO-E Transparency (Phase 2) ------------------------------------------
# Free: register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# with subject "Restful API access" to have the API token enabled on your account.
ENTSOE_API_KEY=

# --- Anthropic (Phase 2, agent) ----------------------------------------------
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Frontend (frontend/.env.local, Vite requires the VITE_ prefix) ----------
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Bright Sky (DWD weather) and SMARD need no keys.
