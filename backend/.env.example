# InfraAtlas backend (brief 25). Locally: copy to backend/.env. In Lambda: plain settings come
# from the SAM template; secrets from SSM SecureString parameters under SSM_PREFIX (/infraatlas/,
# lower-case names, e.g. /infraatlas/anthropic_api_key). Lists take JSON or comma-separated values.

# --- models (agent/models.yaml); "fake" runs the scripted test model without keys
AGENT_MODEL=anthropic:claude-opus-5-5
AGENT_MODEL_FAST=anthropic:claude-haiku-5-5
AGENT_MODELS_ALLOWED=claude-opus-5-5,claude-haiku-5-5
ANTHROPIC_API_KEY=            # console.anthropic.com
OPENAI_API_KEY=               # optional: platform.openai.com (uv sync --extra openai)
GOOGLE_API_KEY=               # optional: aistudio.google.com (uv sync --extra google)
GROQ_API_KEY=                 # optional: console.groq.com (uv sync --extra groq)
BEDROCK_API_KEY=              # optional: an Amazon Bedrock API key (uv sync --extra aws); or IAM credentials
AWS_REGION=eu-central-1       # Bedrock's region (and DynamoDB's in Lambda)

# --- the lake on R2 (read-only token for infraatlas-raw/lake/, read-write for agent/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LAKE_DB=r2://infraatlas-raw/lake/lake.duckdb   # empty: only the app tables
LAKE_DIR=                     # a local directory of Parquet files instead (tests, laptop)

# --- observability
LANGFUSE_PUBLIC_KEY=          # cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=  # any OTLP/HTTP collector (overrides Langfuse's endpoint)
OTEL_CONSOLE=false            # print spans (development)

# --- service keys (generate: openssl rand -hex 32)
ADMIN_API_KEY=                # POST /api/admin/sql (header X-Admin-Key)
MCP_API_KEYS=                 # /mcp bearer keys, comma-separated; empty = MCP off
PROXY_SECRET=                 # the Worker's X-Atlas-Proxy header
REQUIRE_PROXY=false           # true: refuse requests without it

# --- caps and limits
DAILY_SPEND_CAP_USD=20
IP_REQUESTS_PER_HOUR=30
DYNAMODB_TABLE=               # set by the SAM template; empty = in-memory counters
CORS_ORIGINS=https://energy-grid.infraatlas.workers.dev,http://localhost:5173

# --- live sources
EIA_API_KEY=                  # the live tool's eia930 source

# --- local runs only
FAKE_STREAM_DELAY_S=0         # the fake model's pause per streamed word (streaming probe)
