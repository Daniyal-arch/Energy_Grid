// Cloudflare deploy: a static-assets-only Worker serving the Vite build (dist/).
// Cloudflare builds it from GitHub: root directory "frontend", build command
// "npm run build", deploy command "npx wrangler deploy".
{
  "name": "energy-grid",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
